{
  "_comment": "Shared pathExclude parity table. GENERATED from the TypeScript matchesPathExclude (src/typescript/mcp-server/src/utils/path-glob.ts), which is the reference. The daemon applies the same exclude before its result cap, so the two implementations must agree on every row: if the daemon excluded MORE, matches the MCP server would keep become unreachable; if it excluded LESS, the server would drop them after the cap and report an overstated total. Read by text_search::path_exclude tests (Rust) and tests/utils/path-exclude-parity.test.ts (TS).",
  "cases": [
    {
      "path": "/repo/src/rust/a.rs",
      "exclude": "src/rust/**",
      "excluded": true,
      "why": "subtree glob, absolute indexed path"
    },
    {
      "path": "/repo/old_project/x.ts",
      "exclude": "old_project/**",
      "excluded": true,
      "why": "root-level subtree"
    },
    {
      "path": "/repo/pkg/old_project/x.ts",
      "exclude": "old_project/**",
      "excluded": true,
      "why": "floats to any depth"
    },
    {
      "path": "/repo/src/a.rs",
      "exclude": "old_project/**",
      "excluded": false,
      "why": "unrelated path stays"
    },
    {
      "path": "/repo/src/x.rs",
      "exclude": "src/*.rs",
      "excluded": true,
      "why": "single star, one level"
    },
    {
      "path": "/repo/src/deep/x.rs",
      "exclude": "src/*.rs",
      "excluded": false,
      "why": "single star must NOT cross a slash (the daemon include matcher does)"
    },
    {
      "path": "/repo/tests/a.test.ts",
      "exclude": "**/*.test.ts",
      "excluded": true,
      "why": "leading ** suffix glob"
    },
    {
      "path": "/repo/src/a.ts",
      "exclude": "**/*.test.ts",
      "excluded": false,
      "why": "suffix glob miss"
    },
    {
      "path": "/repo/docs/archive/a.md",
      "exclude": "docs/archive",
      "excluded": true,
      "why": "wildcard-free literal scopes to its subtree"
    },
    {
      "path": "/repo/docs/archive",
      "exclude": "docs/archive",
