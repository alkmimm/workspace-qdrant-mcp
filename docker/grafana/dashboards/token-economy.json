{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "MCP token-economy (spec 20): response-byte savings, followup/escalation friction, and shape-mode adoption, sampled from the memexd token_savings view. All series are 24h snapshot gauges (do NOT wrap in rate()). Default view is agent traffic (actor=\"claude\"); the eval/benchmark harness is actor=\"user\".",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Savings Ratio (24h, agents)",
      "description": "1 - bytes_out/bytes_in across all agent calls in the last 24h. Higher is better. This is the headline token-economy number.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "green", "value": 0.7 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - sum(memexd_mcp_token_bytes_out_recent{actor=\"claude\"}) / clamp_min(sum(memexd_mcp_token_bytes_in_recent{actor=\"claude\"}), 1)",
          "legendFormat": "savings",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Bytes Saved (24h, agents)",
      "description": "sum(bytes_in) - sum(bytes_out) across agent calls in the last 24h.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(memexd_mcp_token_bytes_in_recent{actor=\"claude\"}) - sum(memexd_mcp_token_bytes_out_recent{actor=\"claude\"})",
          "legendFormat": "bytes saved",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "≈ Tokens Saved (24h, agents)",
      "description": "Bytes saved divided by 4 — the conservative bytes→tokens proxy the `wqm admin token-savings` CLI uses (tokenizer-independent).",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(memexd_mcp_token_bytes_in_recent{actor=\"claude\"}) - sum(memexd_mcp_token_bytes_out_recent{actor=\"claude\"})) / 4",
          "legendFormat": "≈ tokens",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Followup Rate (24h, agents)",
      "description": "Fraction of agent calls followed by an overlapping re-query within 60s (had_followup). LOWER is better — savings that force a re-query are not real savings (spec 20 §1.2).",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(memexd_mcp_token_followup_recent{actor=\"claude\"}) / clamp_min(sum(memexd_mcp_token_calls_recent{actor=\"claude\"}), 1)",
          "legendFormat": "followup",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Escalation Rate (24h, agents)",
      "description": "Fraction of agent calls escalated to a delivered retrieve (had_escalation). Context: a truncated result the agent then had to expand.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.35 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(memexd_mcp_token_escalation_recent{actor=\"claude\"}) / clamp_min(sum(memexd_mcp_token_calls_recent{actor=\"claude\"}), 1)",
          "legendFormat": "escalation",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Savings Ratio by Tool (agents)",
      "description": "Per-tool 1 - bytes_out/bytes_in over the last 24h (agent traffic). A tool trending toward 0 is shipping nearly its whole payload; a negative value means a tool grew the response (shaping overhead).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - (memexd_mcp_token_bytes_out_recent{actor=\"claude\"} / clamp_min(memexd_mcp_token_bytes_in_recent{actor=\"claude\"}, 1))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Response Bytes In vs Out (24h, agents)",
      "description": "Total pre-shaping vs delivered response bytes across agent calls. The gap is the saving.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 12, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "delivered (bytes_out)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "pre-shaping (bytes_in)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(memexd_mcp_token_bytes_in_recent{actor=\"claude\"})",
          "legendFormat": "pre-shaping (bytes_in)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(memexd_mcp_token_bytes_out_recent{actor=\"claude\"})",
          "legendFormat": "delivered (bytes_out)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Followup & Escalation Rate by Tool (agents)",
      "description": "Per-tool re-query friction. A tool with a high savings ratio AND a high followup rate is over-shaping — it saved bytes by dropping content the agent needed back.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "memexd_mcp_token_followup_recent{actor=\"claude\"} / clamp_min(memexd_mcp_token_calls_recent{actor=\"claude\"}, 1)",
          "legendFormat": "{{op}} followup",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "memexd_mcp_token_escalation_recent{actor=\"claude\"} / clamp_min(memexd_mcp_token_calls_recent{actor=\"claude\"}, 1)",
          "legendFormat": "{{op}} escalation",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Shape-mode Adoption (24h, agents)",
      "description": "Token-tracked agent calls by shaping mode. `packed` = the responseFormat:\"packed\" bundle, `truncate` = per-line/budget capping, `none` = unshaped, `summary` = metadata-only. Shows how much traffic actually goes through the context-packing paths.",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "stacking": "none",
        "fillOpacity": 80,
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" },
        "xField": "shape_mode"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (shape_mode) (memexd_mcp_token_calls_by_shape_recent{actor=\"claude\"})",
          "legendFormat": "{{shape_mode}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "title": "Token-tracked Calls by Tool (agents)",
      "description": "Volume of agent calls that carried token-economy instrumentation (bytes_in present) in the last 24h, per tool. Denominator for the rates above.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "memexd_mcp_token_calls_recent{actor=\"claude\"}",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Calls by Tool & Actor (24h)",
      "description": "All actors, not just agents. actor=\"claude\" is real agent traffic; actor=\"user\" is the eval/benchmark harness + CLI — whose byte profile is excluded from the ratio panels so a benchmark run does not skew the savings number.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "memexd_mcp_token_calls_recent",
          "legendFormat": "{{op}} · {{actor}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["wqm", "mcp", "token-economy"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "WQM — Token Economy",
  "uid": "wqm-token-economy",
  "version": 1
}
