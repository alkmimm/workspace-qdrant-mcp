{
  "annotations": { "list": [] },
  "description": "Decide whether PT->EN query translation is worth enabling, and once enabled whether it is earning its latency. The language verdict is recorded even with the feature OFF, so the top row answers 'would this touch real traffic?' at zero cost. See docs/plans/2026-08-11-query-translation-plan.md.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Decision — is it worth enabling? (collected with the feature OFF)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Non-English share of ranked searches",
      "description": "The headline number: the fraction of traffic the translated leg would touch, recorded regardless of whether translation is enabled. CUMULATIVE since the MCP started — deliberately NOT scoped by the time picker. rate()/increase() over a low-traffic window reports 0 until several events land inside it, which is precisely the regime this dashboard is meant to observe. Split by actor so heavy development traffic can be told apart from real use. Below ~5% the feature is mostly dead weight.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(wqm_mcp_query_language_total{verdict=\"non_english\"}) / clamp_min(sum(wqm_mcp_query_language_total), 1)",
          "legendFormat": "all actors",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(wqm_mcp_query_language_total{verdict=\"non_english\",actor=\"user\"}) / clamp_min(sum(wqm_mcp_query_language_total{actor=\"user\"}), 1)",
          "legendFormat": "actor=user",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "blue", "value": 0.05 },
              { "color": "green", "value": 0.15 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Cumulative searches by verdict and actor",
      "description": "Absolute volume behind the share, as running totals rather than a rate — at this traffic level a rate() plot is a flat line at zero and tells you nothing. A high percentage over a handful of searches is not a signal: read the counts here before acting on the ratio.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 1 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (verdict, actor) (wqm_mcp_query_language_total)",
          "legendFormat": "{{verdict}} / {{actor}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "Health — is the translator working? (needs the feature ON)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Translation failure rate",
      "description": "Share of ATTEMPTED translations that came back unusable — HTTP error, timeout, an echo of the input, still in the source language, or a runaway reply. Each one falls back to a single leg, so it costs a round-trip and returns nothing. The 1.5B sidecar failed 2 of 8 smoke queries this way; a rate creeping up here is the signal to swap the model, not to disable the feature.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(wqm_mcp_query_translation_total{outcome=\"translation_failed\"}) / clamp_min(sum(wqm_mcp_query_translation_total{outcome=~\"translated|translation_failed\"}), 1)",
          "legendFormat": "failed",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Second-leg outcomes",
      "description": "Where every ranked search ended up. `disabled` dominating means the feature is off — expected until it is switched on. `already_english` is the free path: the local gate declined and no round-trip was made.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 8 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (wqm_mcp_query_translation_total)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "The queries themselves",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 103,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Non-English searches — actual text",
      "description": "The counters say HOW MUCH; this says WHICH. Query text cannot live in a Prometheus label (unbounded cardinality), so it ships as a structured log line and is tabled from Loki here. Reading the real phrasings is what tells you whether a non-English share is worth acting on — and once translation is on, a bad translation is visible right next to the query that produced it. Same data already persisted in search_events, on a channel Grafana can render.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "id": 7,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=\"wqm-mcp\"} |= \"[query-language]\" | json | verdict = `non_english`",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": { "source": "labels", "replace": false, "keepTime": false }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "id": true,
              "tsNs": true,
              "container": true,
              "filename": true,
              "job": true,
              "level": true,
              "name": true,
              "component": true,
              "msg": true,
              "time": true,
              "verdict": true,
              "service_name": true,
              "detected_level": true,
              "tsLabel": true
            },
            "indexByName": {},
            "renameByName": {
              "Time": "when",
              "query": "query (as typed)",
              "translated": "translation",
              "reason": "outcome",
              "translate_ms": "ms",
              "actor": "actor",
              "signal": "why non-English"
            }
          }
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "left" } }, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "when", "desc": true }] }
    },
    {
      "type": "row",
      "title": "Value — is it earning its latency?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Hits contributed by the translated leg",
      "description": "The one that separates 'translation ran' from 'translation helped'. `translated_only` are hits the original query never surfaced — the rescues the feature exists for. `both_legs` is cross-language agreement. If translations succeed but this stays at zero, the leg is paying latency for nothing and should be turned off.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 26 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (agreement) (rate(wqm_mcp_translated_leg_hits_total[$__rate_interval]))",
          "legendFormat": "{{agreement}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "type": "timeseries",
      "title": "Translation round-trip latency",
      "description": "Added ONLY to non-English searches; English queries never reach the sidecar. Measured medians: 123ms for a 1.5B, 182ms for a 7B, +14ms for the domain glossary. A p95 past ~0.5s means the sidecar is contending for the GPU with the embedder and the trade needs revisiting.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 26 },
      "id": 6,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(wqm_mcp_query_translation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(wqm_mcp_query_translation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["wqm", "mcp", "search", "query-translation"],
  "templating": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "WQM — Query Translation",
  "uid": "wqm-query-translation",
  "version": 1
}
